# Obtain keys yourself. Never commit your .env file.
OPENWEATHER_API_KEY=
# Google Maps Platform: enable Geocoding API for this server-side key.
GOOGLE_MAPS_SERVER_KEY=
# OPTIONAL, separate browser key restricted to localhost/your domain.
# Enable Maps JavaScript API if you want the interactive map.
GOOGLE_MAPS_BROWSER_KEY=
# OPTIONAL: USDA NASS Quick Stats API key for live hog inventory/harvest statistics.
# Without it, a dated official USDA snapshot is displayed.
NASS_API_KEY=
PORT=3000
